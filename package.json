{
  "name": "sunumarket-server",
  "version": "0.1.0",
  "description": "Backend API for SunuMarket prototype",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:restart": "pm2 restart sunumarket-api",
    "pm2:logs": "pm2 logs sunumarket-api",
    "backup:db": "node scripts/backup-db.js"
  },
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.0",
    "nodemailer": "^6.9.4",
    "pdfkit": "^0.13.0",
    "stripe": "^12.11.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
}
